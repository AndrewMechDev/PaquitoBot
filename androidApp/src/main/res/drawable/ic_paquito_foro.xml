<?xml version="1.0" encoding="utf-8"?>
<!--
  Foro / chat-bubble icon (Figma node 365:1039 area, usado al costado de
  "Tareas Pendientes" en HomeScreen).

  Convertido el 2026-08-06 desde svg/foro icon.svg usando la skill
  svg-to-vector-drawable. SVG original 41x41 viewBox, 3 paths con stroke
  negro de 2.5dp (no fill), conversion directa usando strokeColor +
  strokeWidth en lugar de fillColor. fillColor=#00000000 para que el
  render respete solo el stroke.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="41dp"
    android:height="41dp"
    android:viewportWidth="41"
    android:viewportHeight="41">

    <!-- Burbuja principal (la que contiene la conversacion del foro) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#000000"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M7.75,22.75H14.25M8.75,29.75H1.25V10.75H25.25V29.75H15.25L8.75,37.25V29.75Z" />

    <!-- Linea de texto interior (representa un mensaje del foro) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#000000"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M7.75,17.75H19.25" />

    <!-- Burbuja secundaria que se superpone (la "respuesta") -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#000000"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M15.75,7.75V1.25H39.25V19.75H34.75V28.25L27.25,20.25H25.75" />

</vector>